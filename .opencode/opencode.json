{
  "$schema": "https://opencode.ai/config.json",

  "instructions": [".opencode/rules/ds-rules.md", "DS-IBP/AGENTS.md"],

  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "task": "allow",
    "external_directory": {},
    "skill": { "*": "allow" },
    "edit": { "*": "allow" },
    "bash": {
      "*": "allow",
      "rm *": "deny",
      "git push*": "deny",
      "git reset*": "deny"
    }
  },

  "share": "disabled",
  "autoupdate": false
}
