{
  "contract": 1,
  "id": "ibp-prototypes",
  "name": "Прототипы IBP",
  "purpose": "интерактивные прототипы на дизайн-системе IBP; результат работы агента",

  "designSystem": {
    "mount": "design-system",
    "source": { "type": "inline" }
  },
  "agentKit": {
    "mount": ".agents",
    "tools": ".agents/tools",
    "adapter": ".opencode",
    "source": { "type": "inline" }
  },

  "boot": { "dir": "boot", "head": "boot/ds-head.js", "body": "boot/ds-body.js", "generated": true },

  "hub": {
    "page": "index.html",
    "registry": "hub.js",
    "registryFormat": "script-global",
    "managed": false
  },

  "state": ".agent-state",
  "docs": "docs",

  "apps": { "dir": "apps", "manifest": "app.json" },
  "appShape": { "pages": "pages", "components": "components", "data": "data", "refs": "refs" },

  "tracks": [
    { "id": "product", "title": "Проекты", "hubGroup": "projects", "custom": "forbidden", "agentEdit": "ask",
      "desc": "соответствует настоящей системе, строго на ДС" },
    { "id": "rnd", "title": "Концепты", "hubGroup": "concepts", "custom": "by-spec", "agentEdit": "allow",
      "desc": "R&D: кастом допустим, если ТЗ прямо просит" }
  ]
}
